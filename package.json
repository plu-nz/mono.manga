{
  "name": "mono.manga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "build": "pnpm run check && vite build",
    "verify": "pnpm run test && pnpm run build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@plunz/storybook": "github:plu-nz/lib.storybook#577a0d1",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.3",
    "fflate": "^0.8.2",
    "hono": "^4.13.16",
    "idb": "^8.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.157.0"
  }
}
