{
  "name": "plunz-manga",
  "main": "worker/index.ts",
  "account_id": "d9843893c0daa49287456b9efb2cd021",
  "compatibility_date": "2026-11-04",
  "vars": { "GOOGLE_CLIENT_ID": "294813966893-7asau02c1oisasmjlu8l0nv95n94t0t2.apps.googleusercontent.com" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
    { "name": "IMAGE_LIMIT", "namespace_id": "1102", "simple": { "limit": 1200, "period": 60 } }
  ],
  "routes": [{ "pattern": "manga.plu.nz", "custom_domain": true }]
}
